[Unit]
Description=Python Flask App
After=network.target

[Service]
# Run as a dedicated, unprivileged user (not root)
User=myapp
Group=myapp
WorkingDirectory=/opt/myapp
ExecStart=/usr/bin/python3 /opt/myapp/main.py
# Restart automatically if the app crashes
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Send app output to a log file that CloudWatch collects
StandardOutput=append:/var/log/myapp/app.log
StandardError=append:/var/log/myapp/app.log

[Install]
WantedBy=multi-user.target
